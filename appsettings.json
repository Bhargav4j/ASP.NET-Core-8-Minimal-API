{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};"
  },
  "AppSettings": {
    "Environment": "${ASPNETCORE_ENVIRONMENT}",
    "ApiBaseUrl": "${API_BASE_URL}"
  }
}
